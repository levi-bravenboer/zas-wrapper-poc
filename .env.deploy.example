# AWS demo deploy — root .env template (committed example; real values NEVER
# committed). On the box, user-data writes the real .env next to
# docker-compose.deploy.yml: non-secret values come from CDK context, secret
# values are synced from the SSE-KMS S3 bucket. docker compose reads this file
# automatically for ${VAR} interpolation.

# ---- Injected by CDK context (non-secret) ----
ECR_REGISTRY=000000000000.dkr.ecr.eu-west-1.amazonaws.com
IMAGE_TAG=latest              # set to the git sha by deploy:up
APP_HOST=app.zas.lebba.nl     # orchestrator / SPA
API_HOST=api.zas.lebba.nl     # backend API
FILES_HOST=files.zas.lebba.nl # MinIO (presigned upload/download)
LE_EMAIL=levi.bravenboer@reaktor.com  # Let's Encrypt registration / expiry notices

# ---- Secrets (synced from S3; fill real values locally before deploy) ----
POSTGRES_USER=zas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zas

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Seeded admin = you (SEED_PROFILE=demo seeds only this user + bladder pathway)
BACKEND_BOOTSTRAP_ADMIN_EMAIL=levi.bravenboer@reaktor.com
BACKEND_BOOTSTRAP_ADMIN_NAME=Levi Bravenboer
BACKEND_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ---- Optional backend extras (apps/backend/.env, env_file required:false) ----
# BACKEND_LUSCII_API_TOKEN=...   # leave unset → Luscii fixtures/unconfigured
