# ZAS Wrapper Backend — env example
# Copy to `.env` and adjust for your local environment.
# All env vars are prefixed BACKEND_ (see app/core/settings.py).
#
# Note: when the backend runs inside `zas_backend` (via `moon run :stack`),
# compose overrides these defaults — DB host becomes `db`, not `localhost`.
# This file describes the host-side defaults used by native tools
# (alembic CLI from the host, scripts, ad-hoc python runs).

# Environment: dev | test | production
BACKEND_ENV=dev

# CORS — comma- or JSON-separated list of allowed origins.
# Pydantic-settings accepts a JSON array; the dev default below matches the
# Vite dev server origin used by apps/orchestrator.
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Session signer. MUST be replaced in production with a high-entropy secret.
BACKEND_SESSION_SECRET_KEY=change-me-in-production

# Cookie name for the signed session token.
BACKEND_SESSION_COOKIE_NAME=BACKEND_SESSION

# Public URL the backend is served from (used in OpenAPI `servers`).
# Leave blank for local development.
# BACKEND_PUBLIC_URL=https://api.example.local

# Adapter modes: stub | live. Live mode is not implemented yet (lands in
# the hix-fhir-proxy and luscii-integration changes).
BACKEND_HIX_MODE=stub
BACKEND_LUSCII_MODE=stub

# Logging level for native runs. Compose pins INFO in dev, WARNING in tests.
BACKEND_LOG_LEVEL=INFO

# Database. SQLAlchemy async DSN — Postgres via asyncpg.
# Host-side value (alembic CLI, ad-hoc scripts). Inside `zas_backend`,
# compose overrides this to `postgresql+asyncpg://zas:zas@db:5432/zas`.
# Dev DB binds host port 5434 (5432 is commonly taken by other local
# Postgres instances); container-internal stays 5432.
BACKEND_DATABASE_URL=postgresql+asyncpg://zas:zas@localhost:5434/zas

# Session lifetime in seconds. Default 8h. Tighten for hosted PoC.
# BACKEND_SESSION_MAX_AGE_SECONDS=3600

# ---------------------------------------------------------------------------
# Ory access plane (Kratos sessions + Keto relation checks).
# Code default is OFF so host-side runs (unit tests, ad-hoc uvicorn) work
# without Ory. The compose stack defaults it ON (Kratos + Keto are always
# part of the stack). Set true here only if you run Kratos/Keto on the host.
# ---------------------------------------------------------------------------
# BACKEND_AUTHZ_KETO_ENABLED=true
# BACKEND_KRATOS_PUBLIC_URL=http://localhost:4433
# BACKEND_KRATOS_ADMIN_URL=http://localhost:4434
# BACKEND_KETO_READ_URL=http://localhost:4466
# BACKEND_KETO_WRITE_URL=http://localhost:4467

# ---------------------------------------------------------------------------
# Bootstrap user passwords (consumed by `scripts/seed_users.py`).
# Fallback is the literal string `changeme` in non-production environments.
# In production the seed script refuses to run with the fallback.
# Generate strong values, e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
# ---------------------------------------------------------------------------
# BACKEND_BOOTSTRAP_ADMIN_PASSWORD=replace-me
# BACKEND_BOOTSTRAP_CAREGIVER_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Hosted PoC checklist (synthetic data only; copy + adjust into deploy env):
#
#   BACKEND_ENV=production
#   BACKEND_SESSION_SECRET_KEY=<48 bytes base64-url; never commit>
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
#   BACKEND_CORS_ORIGINS=["https://app.your-domain.example"]
#   BACKEND_PUBLIC_URL=https://api.your-domain.example
#   BACKEND_SESSION_MAX_AGE_SECONDS=3600
#   BACKEND_DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DB
#   BACKEND_HIX_MODE=stub
#   BACKEND_LUSCII_MODE=stub
#   BACKEND_AUTHZ_KETO_ENABLED=true   # hosted envs MUST run relation checks
#   BACKEND_KRATOS_PUBLIC_URL=/_KRATOS_ADMIN_URL=/_KETO_READ_URL=/_KETO_WRITE_URL=<Forge service URLs>
#   BACKEND_BOOTSTRAP_ADMIN_PASSWORD=<strong random, ≥16 chars>
#   BACKEND_BOOTSTRAP_CAREGIVER_PASSWORD=<strong random, ≥16 chars>
#
# Required external controls (not env vars):
#   - HTTPS terminator in front of backend (`__Host-` cookie requires Secure)
#   - Reverse-proxy rate limit on POST /auth/login/password (e.g. 5/min/IP)
#   - Synthetic / non-PII data only
# ---------------------------------------------------------------------------
