      "PathwayBlockDeferredFieldIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "block_id": {
            "type": "string",
            "format": "uuid",
            "title": "Block Id"
          },
          "field_path": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Field Path"
          }
        },
        "type": "object",
        "required": [
          "id",
          "block_id",
          "field_path"
        ],
        "title": "PathwayBlockDeferredFieldIn"
      },
      "PathwayBlockDeferredFieldOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "block_id": {
            "type": "string",
            "format": "uuid",
            "title": "Block Id"
          },
          "field_path": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Field Path"
          }
        },
        "type": "object",
        "required": [
          "id",
          "block_id",
          "field_path"
        ],
        "title": "PathwayBlockDeferredFieldOut"
      },
      "PathwayBlockIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "phase_id": {
            "type": "string",
            "format": "uuid",
            "title": "Phase Id"
          },
          "lane_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lane Id",
            "description": "Optional. When omitted the backend materializes the block type's default lane (see catalogue.default_lane_kind_code)."
          },
          "type": {
            "type": "string",
            "maxLength": 63,
            "minLength": 1,
            "title": "Type"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "duration_value_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Value Id"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "x": {
            "type": "integer",
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "integer",
            "title": "Y",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "phase_id",
          "type"
        ],
        "title": "PathwayBlockIn"
      },
      "PathwayBlockOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "phase_id": {
            "type": "string",
            "format": "uuid",
            "title": "Phase Id"
          },
          "lane_id": {
            "type": "string",
            "format": "uuid",
            "title": "Lane Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "duration_value_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Value Id"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "x": {
            "type": "integer",
            "title": "X",
            "default": 0
          },
          "y": {
            "type": "integer",
            "title": "Y",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "phase_id",
          "lane_id",
          "type"
        ],
        "title": "PathwayBlockOut"
      },
      "PathwayBlockType": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Stable kebab-case identifier"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "default_lane_kind_code": {
            "type": "string",
            "title": "Default Lane Kind Code",
            "description": "Stable lane-kind code (D10): patient | caregiver | system | external"
          },
          "config_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config Schema"
          },
          "supports_branches": {
            "type": "boolean",
            "title": "Supports Branches",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "type",
          "label",
          "default_lane_kind_code",
          "config_schema"
        ],
        "title": "PathwayBlockType"
      },
      "PathwayCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "clinical_goal": {
            "type": "string",
            "minLength": 1,
            "title": "Clinical Goal"
          },
          "patient_goal": {
            "type": "string",
            "minLength": 1,
            "title": "Patient Goal"
          }
        },
        "type": "object",
        "required": [
          "name",
          "clinical_goal",
          "patient_goal"
        ],
        "title": "PathwayCreate"
      },
