            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "block_id": {
            "type": "string",
            "format": "uuid",
            "title": "Block Id"
          },
          "label": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Label"
          },
          "ord": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Ord"
          }
        },
        "type": "object",
        "required": [
          "id",
          "block_id",
          "label",
          "ord"
        ],
        "title": "PathwayBlockBranchOut"
