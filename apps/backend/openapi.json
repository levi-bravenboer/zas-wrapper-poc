      },
      "OrganisationRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "parent_organisation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Organisation Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type_code": {
            "type": "string",
            "title": "Type Code"
          },
          "type_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type System"
          },
          "type_display": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type Display"
          }
        },
        "type": "object",
        "required": [
          "id",
          "parent_organisation_id",
          "name",
          "type_code",
          "type_system",
          "type_display"
        ],
        "title": "OrganisationRead"
      },
      "Page_PatientRead_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PatientRead"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total",
          "total_pages"
        ],
        "title": "Page[PatientRead]"
      },
      "PatientCreate": {
        "properties": {
          "primary_organisation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Primary Organisation Id"
          },
          "given_name": {
            "type": "string",
            "title": "Given Name"
          },
          "family_name": {
            "type": "string",
            "title": "Family Name"
          },
          "birth_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "source": {
            "$ref": "#/components/schemas/PatientSource",
            "default": "local"
          },
          "external_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External System"
          },
          "external_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Ref"
          },
          "external_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Version"
          },
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/PatientIdentifierCreate"
            },
            "type": "array",
            "title": "Identifiers",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "primary_organisation_id",
          "given_name",
          "family_name",
          "gender"
        ],
        "title": "PatientCreate",
        "description": "`POST /patients` payload.\n\n`identifiers` is part of the create payload so a patient can be born\nwith an INSZ in a single transaction. Updating identifiers later goes\nthrough a dedicated endpoint (out of scope for `patients-base`); the\nPATCH route rejects the field outright (see `PatientUpdate`)."
      },
      "PatientIdentifierCreate": {
        "properties": {
          "system": {
            "type": "string",
            "title": "System"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "use": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Use"
          }
        },
        "type": "object",
        "required": [
          "system",
          "value"
        ],
        "title": "PatientIdentifierCreate",
        "description": "Identifier payload for `POST /patients`.\n\n`system` is a free-text URI \u2014 we keep the column open so unknown\nnamespaces (e.g. local lab numbers) pass through. The Mod-97 check\nonly runs when the system is the Belgian INSZ namespace."
      },
      "PatientIdentifierRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "system": {
            "type": "string",
            "title": "System"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "use": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Use"
          }
        },
        "type": "object",
        "required": [
          "id",
          "system",
          "value"
        ],
        "title": "PatientIdentifierRead"
      },
      "PatientRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "primary_organisation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Primary Organisation Id"
          },
          "given_name": {
            "type": "string",
            "title": "Given Name"
          },
          "family_name": {
            "type": "string",
            "title": "Family Name"
          },
          "birth_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "source": {
            "$ref": "#/components/schemas/PatientSource"
          },
          "external_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External System"
          },
          "external_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Ref"
          },
          "external_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Version"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Synced At"
          },
          "identifiers": {
            "items": {
              "$ref": "#/components/schemas/PatientIdentifierRead"
            },
            "type": "array",
            "title": "Identifiers",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "primary_organisation_id",
          "given_name",
          "family_name",
          "gender",
          "source"
        ],
        "title": "PatientRead"
      },
      "PatientSource": {
        "type": "string",
        "enum": [
          "local",
          "hix",
          "luscii"
        ],
        "title": "PatientSource"
      },
      "PatientUpdate": {
        "properties": {
          "given_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Given Name"
          },
          "family_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family Name"
          },
          "birth_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
