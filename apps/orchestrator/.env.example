# Docker mode (moon run backend:dev → container on 18000):
#   VITE_API_BASE_URL=http://localhost:18000
# Host mode (moon run backend:dev-host → uvicorn on 8000):
VITE_API_BASE_URL=http://localhost:8000
VITE_API_MODE=mock

# Hosted PoC:
#   VITE_API_BASE_URL=https://api.your-domain.example
#   VITE_API_MODE=live
