# syntax=docker/dockerfile:1.7
# Deploy image for the orchestrator SPA: build with Vite, serve via nginx,
# terminate TLS on the box with Let's Encrypt (certbot). Browser-facing
# VITE_* are build-time and baked here from --build-arg.

FROM node:22.13-alpine AS build
WORKDIR /app

# Build-time public config (inlined into the bundle by Vite).
ARG VITE_API_BASE_URL
ARG VITE_API_MODE=real
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_API_MODE=${VITE_API_MODE}

# Install pnpm directly — corepack in node:22.13 can't verify newer pnpm
# signing keys ("Cannot find matching keyid").
RUN npm install -g pnpm@9.15.1
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Build in development mode: no feature module has adopted the registry yet
# (src/modules/index.ts is an empty barrel), so the PROD-only "registry empty"
# guard in main.tsx would otherwise abort boot. Dev-mode keeps env.PROD false;
# the real pages are normal routes and work the same. Fine for a throwaway demo.
RUN pnpm exec tsr generate && pnpm exec tsc -b && pnpm exec vite build --mode development

FROM nginx:1.27-alpine AS runtime
RUN apk add --no-cache certbot openssl bash gettext
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/entrypoint.sh /usr/local/bin/orchestrator-entrypoint
RUN chmod +x /usr/local/bin/orchestrator-entrypoint

EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/orchestrator-entrypoint"]
